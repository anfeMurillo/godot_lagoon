#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

def _lagoonic_agent_logos_header():
    # Agent logos (editor/agent_logos/<agent id>.png) baked into the editor:
    # the team panel shows them without network access. Rewritten only when
    # the PNGs change, so it does not trigger rebuilds.
    import os

    logo_dir = os.path.join(Dir(".").srcnode().abspath, "editor", "agent_logos")
    out_path = os.path.join(Dir(".").srcnode().abspath, "editor", "lagoonic_agent_logos.gen.h")
    lines = ["/* Generated by modules/lagoonic/SCsub from editor/agent_logos. Do not edit. */", "#pragma once", ""]
    names = sorted(f for f in os.listdir(logo_dir) if f.endswith(".png")) if os.path.isdir(logo_dir) else []
    for i, name in enumerate(names):
        with open(os.path.join(logo_dir, name), "rb") as f:
            data = f.read()
        lines.append("static const unsigned char _lagoonic_logo_%d[] = {%s};" % (i, ",".join(str(b) for b in data)))
    lines.append("")
    lines.append("struct LagoonicAgentLogoData {")
    lines.append("\tconst char *id;")
    lines.append("\tconst unsigned char *data;")
    lines.append("\tint size;")
    lines.append("};")
    lines.append("")
    lines.append("static const LagoonicAgentLogoData LAGOONIC_AGENT_LOGOS[] = {")
    for i, name in enumerate(names):
        lines.append('\t{ "%s", _lagoonic_logo_%d, (int)sizeof(_lagoonic_logo_%d) },' % (name[:-4], i, i))
    lines.append("\t{ nullptr, nullptr, 0 },")
    lines.append("};")
    text = "\n".join(lines) + "\n"
    old = None
    if os.path.exists(out_path):
        with open(out_path, "r") as f:
            old = f.read()
    if old != text:
        with open(out_path, "w") as f:
            f.write(text)


env_lagoonic = env_modules.Clone()

# register_types.cpp is inert without TOOLS_ENABLED (see the guards there),
# so it is always compiled. The bridge itself lives in editor/ and is only
# built for editor targets, following the modules/gridmap pattern.
env_lagoonic.add_source_files(env.modules_sources, "*.cpp")
if env.editor_build:
    _lagoonic_agent_logos_header()
    env_lagoonic.add_source_files(env.modules_sources, "editor/*.cpp")
    if env["platform"] == "macos":
        # Native clip for the embedded game layer (see lagoonic_game_clip.h).
        env_lagoonic.add_source_files(env.modules_sources, "editor/*.mm")

# runtime/ lo poblaran los agentes 3-7. Glob() devuelve lista vacia si la
# carpeta aun no existe, asi que este bloque nunca rompe el build.
if Glob("runtime/*.cpp"):
    env_lagoonic.add_source_files(env.modules_sources, "runtime/*.cpp")
